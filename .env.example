# Copy to .env (scripts/setup.ps1 does this and generates the secrets for you).
# .env is ignored by Git. Never commit real values.
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@karfansa.ir
OTP_TTL_SECONDS=300
POSTGRES_DB=karfansa
POSTGRES_USER=karfansa
POSTGRES_PASSWORD=change-me
# Host ports (change them if something on your machine already uses 5432 or 6379).
POSTGRES_PORT=5432
REDIS_PORT=6379
# Set to true if hot reload does not work on Windows.
VITE_USE_POLLING=false
# Optional market data feed overrides. The provider account's actual endpoint paths
# and authentication requirements should be taken from its API documentation.
MARKET_API_KEY=
MARKET_API_KEY_HEADER=Authorization
MARKET_API_KEY_PREFIX=Bearer
MARKET_EXCHANGE_URL=
MARKET_GOLD_URL=
MARKET_OIL_URL=
MARKET_STOCK_URL=
