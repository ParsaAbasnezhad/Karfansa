# Copy to .env (scripts/setup.ps1 does this and generates the secrets for you).
# .env is ignored by Git. Never commit real values.
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@karfansa.ir
OTP_TTL_SECONDS=300
# Production only: include both public and console hosts in DJANGO_ALLOWED_HOSTS.
# Management API requests are additionally restricted to MANAGEMENT_ALLOWED_HOSTS.
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_ALLOWED_HOSTS=karfansa.ir,www.karfansa.ir,console.karfansa.ir
# DJANGO_CSRF_TRUSTED_ORIGINS=https://karfansa.ir,https://console.karfansa.ir
MANAGEMENT_ALLOWED_HOSTS=console.karfansa.ir
# Legacy flag retained for compatibility; Control Center login is always password-only.
MANAGEMENT_MFA_REQUIRED=false
# Public site Control Center entry point (opened in a new tab; no credentials in URL).
VITE_ADMIN_FRONTEND_URL=http://127.0.0.1:5174
# List only the IP addresses of reverse proxies you control.
MANAGEMENT_TRUSTED_PROXY_IPS=
MANAGEMENT_SESSION_TTL_SECONDS=28800
MANAGEMENT_INACTIVITY_SECONDS=1800
POSTGRES_DB=karfansa
POSTGRES_USER=karfansa
POSTGRES_PASSWORD=change-me
# Host ports (change them if something on your machine already uses 5432 or 6379).
POSTGRES_PORT=5432
REDIS_PORT=6379
# Set to true if hot reload does not work on Windows.
VITE_USE_POLLING=false
