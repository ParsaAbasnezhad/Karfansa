# Backend-only variables for running outside Docker. The root .env.example is used with Docker Compose.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
POSTGRES_DB=karfansa
POSTGRES_USER=karfansa
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@karfansa.ir
OTP_TTL_SECONDS=300
MANAGEMENT_MFA_REQUIRED=false
