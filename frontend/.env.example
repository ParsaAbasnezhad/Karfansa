# Copy to .env and adjust.

# true  = built-in sample data (useful when working on static UI only)
# false = call Django API (required for authentication)
VITE_USE_MOCK=false

# Set VITE_USE_MOCK in the project-root .env too when running the Vite server from the repo root.

# Base path of the Django API (same origin: the Vite dev proxy and nginx forward it to Django)
VITE_API_BASE=/api

# Where the dev proxy sends /api and /media. Inside docker-compose use http://backend:8000
VITE_DEV_PROXY=http://localhost:8000

# Independent Control Center origin opened from the account page (no credentials in URL)
VITE_ADMIN_FRONTEND_URL=http://127.0.0.1:5174
