# Copy to .env and adjust.

# true  = built-in sample data, no backend needed (default in `npm run dev`)
# false = call the Django API (default in `npm run build`)
VITE_USE_MOCK=true

# Base path of the Django API (same origin: the Vite dev proxy and nginx forward it to Django)
VITE_API_BASE=/api

# Where the dev proxy sends /api and /media. Inside docker-compose use http://backend:8000
VITE_DEV_PROXY=http://localhost:8000
